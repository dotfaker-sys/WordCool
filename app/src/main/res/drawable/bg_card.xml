<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃卡片：1dp 渐变描边（左上亮、右下淡）+ 半透明磨砂面 + 顶部高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 渐变描边 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_border_soft"
                android:startColor="@color/glass_border_bright"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- 磨砂玻璃面：左上更亮、右下更透 -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/glass_card_bottom"
                android:startColor="@color/glass_card_top"
                android:type="linear" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <!-- 右下角冷色玻璃染色 -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/glass_card_tint"
                android:startColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <!-- 顶部 40% 的柔光，模拟玻璃反光 -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="@color/glass_shine"
                android:type="linear" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>

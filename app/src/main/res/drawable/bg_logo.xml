<?xml version="1.0" encoding="utf-8"?>
<!-- 顶栏品牌方块：朱红渐变玻璃 + 顶部高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/primary_dark"
                android:startColor="@color/primary"
                android:type="linear" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="@color/glass_border_bright" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#59FFFFFF"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>

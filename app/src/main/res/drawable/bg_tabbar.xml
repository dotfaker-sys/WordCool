<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮玻璃 dock：圆角描边 + 半透明面板 + 顶部高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_border_soft"
                android:startColor="@color/glass_border_bright"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_tabbar_bottom"
                android:startColor="@color/glass_card_top"
                android:type="linear" />
            <corners android:radius="25dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="@color/glass_shine"
                android:type="linear" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- 小胶囊：半透明玻璃面 + 细边 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/glass_card_bottom"
        android:startColor="@color/glass_card_top"
        android:type="linear" />
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="@color/glass_border" />
    <padding
        android:bottom="4dp"
        android:left="10dp"
        android:right="10dp"
        android:top="4dp" />
</shape>

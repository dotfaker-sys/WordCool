<?xml version="1.0" encoding="utf-8"?>
<!-- 详情弹层：接近不透明的磨砂玻璃，保证文字清晰，只保留渐变、亮边和高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_border_soft"
                android:startColor="@color/glass_border_bright"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/sheet_bg_bottom"
                android:startColor="@color/sheet_bg_top"
                android:type="linear" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="@color/glass_shine"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Obsidian 深色输入框：只保留底边细线 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="-2dp" android:right="-2dp" android:top="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/obs_line" />
            <padding android:left="10dp" android:top="8dp" android:right="10dp" android:bottom="8dp" />
        </shape>
    </item>
</layer-list>

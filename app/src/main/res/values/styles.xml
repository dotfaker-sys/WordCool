<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 编辑式排版：纸感底色、浅色状态栏、不叠加默认控件着色。
         AppThemeBase 只放各系统版本通用的项；AppTheme 按 API 版本覆盖系统栏颜色。 -->
    <style name="AppThemeBase" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
        <item name="android:textColorHint">@color/text_sub</item>
    </style>

    <!-- 默认（API 23–26）：状态栏浅纸底 + 深色图标；导航栏深墨底 + 白色图标 -->
    <style name="AppTheme" parent="AppThemeBase">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/text</item>
    </style>

    <!-- 设置页 / 导入页的深色弹窗（只用于简单的标题+正文+按钮） -->
    <style name="ObsidianDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/obs_accent</item>
        <item name="android:colorBackground">@color/obs_surface</item>
        <item name="android:windowBackground">@color/obs_surface</item>
        <item name="android:textColorPrimary">@color/obs_text</item>
        <item name="android:textColorSecondary">@color/obs_sub</item>
        <item name="android:textColorHint">@color/obs_sub</item>
    </style>
</resources>

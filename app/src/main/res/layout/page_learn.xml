<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTodayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日计划"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/tvTodayInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="待学 0 个 · 今日已学 0 个"
                android:textSize="12sp"
                android:textColor="@color/text_sub" />

            <ProgressBar
                android:id="@+id/todayBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPickGroup"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="范围：全部词组"
                    android:textSize="12sp"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/btnStudyOrder"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center"
                    android:text="顺序：顺序"
                    android:textSize="12sp"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnUnlockNew"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center"
                    android:text="解锁今日新词"
                    android:textSize="13sp"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_btn_soft"
                    android:gravity="center"
                    android:text="开始学习"
                    android:textSize="13sp"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSpellStart"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="拼写测试 · 看释义写单词"
                android:textSize="12sp"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- 认词卡片 -->
        <LinearLayout
            android:id="@+id/cardStudy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="认一认 · 先自己想意思"
                android:textSize="12sp"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tvCardWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:fontFamily="serif"
                android:text="word"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/tvCardPhonetic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/text_sub" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSpeakUk"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center"
                    android:text="英音 UK"
                    android:textSize="12sp"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/btnSpeak"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_btn_soft"
                    android:gravity="center"
                    android:text="美音 US"
                    android:textSize="12sp"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/answerBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvCardMeaning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text=""
                    android:textSize="17sp"
                    android:textColor="@color/text"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/tvCardExample"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/text_sub"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:id="@+id/tvCardNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnReveal"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="显示答案"
                android:textSize="14sp"
                android:textColor="@color/white" />

            <LinearLayout
                android:id="@+id/gradeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/gradeBad"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center"
                    android:text="不认识"
                    android:textSize="12sp"
                    android:textColor="@color/danger" />

                <TextView
                    android:id="@+id/gradeFuzzy"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/bg_btn_soft"
                    android:gravity="center"
                    android:text="有点模糊"
                    android:textSize="12sp"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/gradeGood"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center"
                    android:text="认识"
                    android:textSize="12sp"
                    android:textColor="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGradeResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/text_sub"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnStudyNext"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="下一个"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 小测验 -->
        <LinearLayout
            android:id="@+id/cardQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="小测验 · 选出正确释义"
                android:textSize="12sp"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tvQuizWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:fontFamily="serif"
                android:text="word"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <LinearLayout
                android:id="@+id/optionBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/opt0"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center_vertical"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="选项 A"
                    android:textSize="13sp"
                    android:textColor="@color/text" />

                <TextView
                    android:id="@+id/opt1"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center_vertical"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="选项 B"
                    android:textSize="13sp"
                    android:textColor="@color/text" />

                <TextView
                    android:id="@+id/opt2"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center_vertical"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="选项 C"
                    android:textSize="13sp"
                    android:textColor="@color/text" />

                <TextView
                    android:id="@+id/opt3"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center_vertical"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="选项 D"
                    android:textSize="13sp"
                    android:textColor="@color/text" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvQuizResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/btnQuizNext"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="继续"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 拼写测试 -->
        <LinearLayout
            android:id="@+id/cardSpell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSpellLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拼写测试 · 看释义写单词"
                android:textSize="12sp"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tvSpellMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/text_sub" />

            <TextView
                android:id="@+id/tvSpellMeaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text=""
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/tvSpellHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/primary"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etSpell"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:fontFamily="serif"
                android:gravity="center"
                android:hint="在这里输入英文单词"
                android:imeOptions="actionDone"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textSize="22sp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_sub" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSpellSpeak"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center"
                    android:text="听发音（有提示）"
                    android:textSize="12sp"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/btnSpellHint"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_btn_soft"
                    android:gravity="center"
                    android:text="提示首字母"
                    android:textSize="12sp"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSpellCheck"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="检查拼写"
                android:textSize="14sp"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/btnSpellGiveUp"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="不会，看答案"
                android:textSize="12sp"
                android:textColor="@color/danger" />

            <TextView
                android:id="@+id/tvSpellResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnSpellNext"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="下一个"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 完成态 -->
        <LinearLayout
            android:id="@+id/learnEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="22dp">

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="准备好了吗？"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/tvEmptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:text="导入的词默认处于「未解锁」状态，先解锁一批新词，再用卡片和测验把它们变成「已掌握」。"
                android:textSize="13sp"
                android:textColor="@color/text_sub" />

            <TextView
                android:id="@+id/btnMore"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="再解锁一批"
                android:textSize="13sp"
                android:textColor="@color/primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

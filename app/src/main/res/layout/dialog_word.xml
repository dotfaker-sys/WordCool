<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvDialogStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:lineSpacingExtra="3dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="单词 / 词组"
            android:textSize="12sp"
            android:textColor="@color/text_sub" />

        <EditText
            android:id="@+id/etWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="例如 abandon"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="15sp"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="音标（可留空）"
            android:textSize="12sp"
            android:textColor="@color/text_sub" />

        <EditText
            android:id="@+id/etPhonetic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="/əˈbændən/"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp"
            android:textColor="@color/text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="英式音标 UK"
                    android:textSize="12sp"
                    android:textColor="@color/text_sub" />

                <EditText
                    android:id="@+id/etPhoneticUk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:hint="/ˈɑːftə/"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:textColor="@color/text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="美式音标 US"
                    android:textSize="12sp"
                    android:textColor="@color/text_sub" />

                <EditText
                    android:id="@+id/etPhoneticUs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:hint="/ˈæftər/"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:textColor="@color/text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDialogSpeakUk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_btn_soft"
                android:gravity="center"
                android:text="英音试听"
                android:textSize="12sp"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/btnDialogSpeakUs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_btn_soft"
                android:gravity="center"
                android:text="美音试听"
                android:textSize="12sp"
                android:textColor="@color/primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnDialogIpa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_ghost"
            android:gravity="center"
            android:text="查内置词典补全音标"
            android:textSize="12sp"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="留空时沿用上方通用音标。音标可来自文档、手动填写，或点上面这个按钮用随包内置的离线开源词典补全；不需要联网，也不会凭空编造。文档里写「UK /…/ US /…/」会自动拆成两套。"
            android:textSize="11sp"
            android:textColor="@color/text_sub" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="中文释义"
            android:textSize="12sp"
            android:textColor="@color/text_sub" />

        <EditText
            android:id="@+id/etMeaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="放弃；抛弃"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="例句（可留空）"
            android:textSize="12sp"
            android:textColor="@color/text_sub" />

        <EditText
            android:id="@+id/etExample"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="He abandoned the plan. 他放弃了计划。"
            android:inputType="textMultiLine"
            android:padding="8dp"
            android:textSize="13sp"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="记忆提示 / 词根（可留空）"
            android:textSize="12sp"
            android:textColor="@color/text_sub" />

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="a + band + on，联想「一根带子都不要了」"
            android:inputType="textMultiLine"
            android:padding="8dp"
            android:textSize="13sp"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="组别（可留空）"
            android:textSize="12sp"
            android:textColor="@color/text_sub" />

        <EditText
            android:id="@+id/etGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="例如 Unit 1 / Day 2 / Unit 1 Day 1"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp"
            android:textColor="@color/text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDialogSpeak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="默认朗读"
                android:textSize="12sp"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/btnDialogMastered"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_btn_soft"
                android:gravity="center"
                android:text="标为已掌握"
                android:textSize="12sp"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/btnDialogReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="重新学"
                android:textSize="12sp"
                android:textColor="@color/text_sub" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="搜单词或释义"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_sub" />

        <TextView
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="+ 添加"
            android:textSize="14sp"
            android:textColor="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chipRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:gravity="center"
            android:background="@drawable/bg_chip"
            android:text="全部"
            android:textSize="12sp"
            android:textColor="@color/text_sub" />

        <TextView
            android:id="@+id/chipLocked"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:gravity="center"
            android:background="@drawable/bg_chip"
            android:text="未解锁"
            android:textSize="12sp"
            android:textColor="@color/text_sub" />

        <TextView
            android:id="@+id/chipLearning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:gravity="center"
            android:background="@drawable/bg_chip"
            android:text="学习中"
            android:textSize="12sp"
            android:textColor="@color/text_sub" />

        <TextView
            android:id="@+id/chipMastered"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_chip"
            android:text="已掌握"
            android:textSize="12sp"
            android:textColor="@color/text_sub" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnGroupFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_ghost"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="组别：全部词组"
        android:textSize="12sp"
        android:textColor="@color/primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="共 0 个单词"
            android:textSize="13sp"
            android:textColor="@color/text_sub" />

        <TextView
            android:id="@+id/btnUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:background="@drawable/bg_btn_soft"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="解锁新词"
            android:textSize="12sp"
            android:textColor="@color/primary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/unlockBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_horizontal" />

</LinearLayout>

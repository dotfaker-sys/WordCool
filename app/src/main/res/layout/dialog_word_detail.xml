<?xml version="1.0" encoding="utf-8"?>
<!-- 单词详情玻璃底部弹层 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="28dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/detailCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailWord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="word"
                android:textColor="@color/text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDetailClose"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:minHeight="34dp"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/text_sub"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ipaRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailIpaUk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_soft"
                android:paddingLeft="9dp"
                android:paddingTop="4dp"
                android:paddingRight="9dp"
                android:paddingBottom="4dp"
                android:text="UK /…/"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDetailIpaUs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_chip_soft"
                android:paddingLeft="9dp"
                android:paddingTop="4dp"
                android:paddingRight="9dp"
                android:paddingBottom="4dp"
                android:text="US /…/"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetailMeaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:text="释义"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/layoutExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="例句"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/primary" />

                <TextView
                    android:id="@+id/tvDetailExample"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:text=""
                    android:textColor="@color/text_sub"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="记忆提示"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_btn_ghost"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:text=""
                android:textColor="@color/text_sub"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="4dp"
            android:text=""
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDetailUk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_soft"
                android:gravity="center"
                android:minHeight="42dp"
                android:text="英音"
                android:textColor="@color/primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnDetailUs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_soft"
                android:gravity="center"
                android:minHeight="42dp"
                android:text="美音"
                android:textColor="@color/primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnDetailEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:minHeight="42dp"
                android:text="编辑"
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

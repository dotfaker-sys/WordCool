<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="① 导入文档（Word / Excel / PDF）"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="支持 .docx（段落 / 两列表格）、.xlsx（两列）、文字型 .pdf、.txt / .csv。Unit 1 / Day 2 / 第 3 单元 等标题行会自动划组；写 UK /…/ US /…/ 会自动拆成英 / 美两套音标。旧版 .doc / .xls 请另存为新格式，扫描版 PDF 请用「粘贴导入」。\n\n也可以直接从微信把文件发进来，见下方「⑥ 从微信 / QQ 导入」。"
                android:textSize="12sp"
                android:textColor="@color/text_sub" />

            <TextView
                android:id="@+id/btnPickDoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="选择文档并导入"
                android:textSize="14sp"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvImportStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="还没导入过文档"
                android:textSize="12sp"
                android:textColor="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="② 粘贴导入"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="在 Word 里全选复制，粘贴到这里。每行一个词，例如：\nabandon  /əˈbændən/  放弃\nbenefit - 益处\n或用 Tab / 冒号 / 分号分隔。"
                android:textSize="12sp"
                android:textColor="@color/text_sub" />

            <EditText
                android:id="@+id/etPaste"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="把单词表粘贴到这里…"
                android:inputType="textMultiLine"
                android:padding="10dp"
                android:textSize="13sp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_sub" />

            <TextView
                android:id="@+id/btnPasteImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_soft"
                android:gravity="center"
                android:text="解析并导入"
                android:textSize="14sp"
                android:textColor="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="③ 划组管理"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="点任一组可以改名；也可以按顺序自动划成 Unit 1 / Unit 2 或 Day 1 / Day 2。词库页和学习页都能按组筛选。"
                android:textSize="12sp"
                android:textColor="@color/text_sub" />

            <TextView
                android:id="@+id/tvGroupSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="还没有分组"
                android:textSize="12sp"
                android:textColor="@color/primary" />

            <LinearLayout
                android:id="@+id/groupBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etGroupPrefix"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:layout_weight="1.2"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="组名前缀"
                    android:inputType="text"
                    android:maxLines="1"
                    android:text="Unit"
                    android:textSize="13sp"
                    android:textColor="@color/text" />

                <EditText
                    android:id="@+id/etGroupSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:layout_weight="0.7"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:hint="每组个数"
                    android:inputType="number"
                    android:maxLines="1"
                    android:text="20"
                    android:textSize="13sp"
                    android:textColor="@color/text" />

                <TextView
                    android:id="@+id/btnAutoGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="自动划组"
                    android:textSize="13sp"
                    android:textColor="@color/white" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="按词库顺序每 N 个一组，组名 = 前缀 + 序号（前缀填「Unit 1 Day」可得到 Unit 1 Day 1）。会覆盖现有组名。"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_sub" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="④ 内置词库"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="不想自己找文件时，可以直接载入内置词表。考研词库按 Unit 1 Day 1 … Unit 5 Day 3 分成 23 组，先进入导入预览，确认后才写入。"
                android:textSize="12sp"
                android:textColor="@color/text_sub" />

            <TextView
                android:id="@+id/btnLoadKaoyan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="载入考研词库（Unit 1–5 · 711 词）"
                android:textSize="13sp"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/btnLoadDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="载入 12 个示例词"
                android:textSize="12sp"
                android:textColor="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⑤ 编辑单词"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="词库页只读，不再直接点开编辑。要改释义、音标、例句、组别，或删除单词，都在这里搜索后编辑。"
                android:textSize="12sp"
                android:textColor="@color/text_sub" />

            <TextView
                android:id="@+id/btnEditWord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="搜索 / 编辑单词"
                android:textSize="13sp"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⑥ 从微信 / QQ 导入"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="不用先把文件存到手机：在微信里点开别人发的词表 → 右上角「…」→「用其他应用打开」（或长按文件 →「发送给朋友 / 分享」→ 更多），在应用列表里选「单词酷」，文件会直接进导入预览，确认后入库。QQ、企业微信、文件管理器用同一套入口。\n\n也支持多选文件一次发进来（合并成一批预览），以及把一段词表文字直接分享进来。\n\n本应用不会去读微信的私人目录，也不申请任何权限：必须由你在微信里主动选择「单词酷」，系统才把这一个文件的临时读取权交给它。"
                android:textSize="12sp"
                android:textColor="@color/text_sub" />

            <TextView
                android:id="@+id/btnWechatHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_soft"
                android:gravity="center"
                android:text="看详细步骤 / 列表里找不到怎么办"
                android:textSize="12sp"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/btnPickDoc2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="还是用「选择文档并导入」"
                android:textSize="12sp"
                android:textColor="@color/primary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="发音、音标、每日新词数、备份、重置与版本更新已移到「设置」页。"
            android:textSize="11sp"
            android:textColor="@color/text_sub" />

    </LinearLayout>
</ScrollView>

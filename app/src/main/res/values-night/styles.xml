<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 暗色主题：系统控件、弹窗和文字都走深色父主题 -->
    <style name="AppThemeBase" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
        <item name="android:textColorHint">@color/text_sub</item>
    </style>

    <style name="AppTheme" parent="AppThemeBase">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
</resources>
